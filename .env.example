# GitHub API (server-side only — never expose to the client)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=shubhransh-gupta/sketchd-drawings
GITHUB_BRANCH=main

# Public site URL (used in share links from the API)
SITE_URL=http://localhost:5173

# Production only — URL of deployed save API (Cloudflare Worker or Vercel)
# Leave empty for local dev (Vite middleware handles /api/*)
# VITE_API_URL=https://sketchd-api.your-subdomain.workers.dev

# Optional — override raw JSON CDN base for loading drawings
# VITE_DRAWINGS_RAW_BASE=https://raw.githubusercontent.com/shubhransh-gupta/sketchd-drawings/main/drawings
